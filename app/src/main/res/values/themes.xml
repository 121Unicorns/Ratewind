<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.RateWind" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/blue2</item>
        <item name="colorPrimaryVariant">@color/blue3</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <!-- Font. -->
        <item name="fontFamily">@font/quicksand</item>
        <item name="font">@font/quicksand</item>
        <!-- Customize your theme here. -->
        <item name="searchViewStyle">@style/Theme.RateWind.SearchView</item>
    </style>

    <style name="Theme.RateWind.SearchView" parent="Widget.AppCompat.SearchView">
        <item name="searchIcon">@drawable/ic_search</item>
        <item name="android:textColorHint">@color/white</item>
        <item name="android:theme">@style/ThemeOverlay.AppCompat.Dark</item>
    </style>

    <!-- THEME FOR TITLE FONT -->
    <style name="TextTitle" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">35sp</item>
        <item name="android:textColor">@color/blue3</item>
        <item name="fontFamily">@font/quicksand</item>
    </style>

    <!-- TAB TITLE FONT STYLE -->
    <style name="TabText" parent="TextAppearance.AppCompat">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="fontFamily">@font/quicksand</item>
    </style>

    <!-- THEME FOR DIALOG FONT -->
    <style name="TextDialog" parent="Widget.AppCompat.TextView">
        <item name="fontFamily">@font/quicksand</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Theme.RateWind.Fullscreen" parent="Theme.RateWind">
        <item name="android:actionBarStyle">@style/Widget.Theme.RateWind.ActionBar.Fullscreen</item>
        <item name="android:windowActionBarOverlay">true</item>
        <item name="android:windowBackground">@null</item>
    </style>

    <style name="ThemeOverlay.RateWind.FullscreenContainer" parent="">
        <item name="fullscreenBackgroundColor">@color/light_blue_600</item>
        <item name="fullscreenTextColor">@color/light_blue_A200</item>
    </style>

    <style name="LayoutBackground">
        <item name="android:backgroundTint">@color/blue3</item>
    </style>

    <style name="ThemeOverlay.App.MaterialAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="materialAlertDialogBodyTextStyle">@style/TextDialog</item>
    </style>

    <style name="ChatBackground">
        <item name="android:backgroundTint">@color/white</item>
    </style>

</resources>