<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bgflip"
    android:id="@+id/registerlayout"
    tools:context=".RegisterActivity">

    <ImageView
        android:layout_width="@dimen/_150sdp"
        android:layout_height="@dimen/_150sdp"
        android:src="@drawable/lovemessages"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginRight="-20dp"
        android:layout_marginTop="-20dp"
        android:id="@+id/iv_logo"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sign Up"
        android:paddingLeft="@dimen/_8sdp"
        android:textSize="50sp"
        android:textColor="@color/white"
        android:fontFamily="@font/quicksand"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/iv_logo"
        android:layout_marginRight="@dimen/_20sdp"
        android:layout_marginLeft="@dimen/_20sdp"
        android:id="@+id/tv_title"/>

    <RadioGroup
        android:id="@+id/rg_usertype"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_20sdp"
        android:layout_marginTop="@dimen/_15sdp"
        android:layout_marginRight="@dimen/_20sdp"
        android:background="@drawable/editor_background"
        android:elevation="8dp"
        android:tag="Account type"
        android:padding="@dimen/_10sdp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Account type:"
            android:fontFamily="@font/quicksand"
            android:textSize="20sp"
            android:textColor="@color/blue3"
            android:padding="@dimen/_3sdp"/>

        <RadioButton
            android:id="@+id/rb_tenant"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_45sdp"
            android:fontFamily="@font/quicksand"
            android:buttonTint="@color/teal_700"
            android:textColor="@color/blue3"
            android:text="I'm a Tenant"
            android:checked="true"
            android:textSize="20sp" />

        <RadioButton
            android:id="@+id/rb_landlord"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_45sdp"
            android:fontFamily="@font/quicksand"
            android:buttonTint="@color/teal_700"
            android:textColor="@color/blue3"
            android:text="I'm a Property Manager"
            android:textSize="20sp" />
    </RadioGroup>

    <EditText
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"
        android:background="@drawable/editor_background"
        android:textColorHint="@color/blue3"
        android:hint="Full Name"
        android:paddingLeft="@dimen/_15sdp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rg_usertype"
        android:elevation="8dp"
        android:inputType="text"
        android:textSize="20sp"
        android:layout_marginTop="@dimen/_15sdp"
        android:layout_marginRight="@dimen/_20sdp"
        android:layout_marginLeft="@dimen/_20sdp"
        android:orientation="horizontal"
        android:id="@+id/et_name"/>

    <EditText
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"
        android:background="@drawable/editor_background"
        android:textColorHint="@color/blue3"
        android:hint="Email"
        android:paddingLeft="@dimen/_15sdp"
        android:textSize="20sp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/et_name"
        android:elevation="8dp"
        android:inputType="textEmailAddress"
        android:layout_marginTop="@dimen/_15sdp"
        android:layout_marginRight="@dimen/_20sdp"
        android:layout_marginLeft="@dimen/_20sdp"
        android:orientation="horizontal"
        android:id="@+id/et_email"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"
        android:background="@drawable/editor_background"
        android:textColorHint="@color/blue3"
        android:gravity="center"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/et_email"
        android:elevation="8dp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginRight="@dimen/_20sdp"
        android:layout_marginLeft="@dimen/_20sdp"
        android:orientation="horizontal"
        android:id="@+id/til_phone">

        <com.hbb20.CountryCodePicker
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:ccpDialog_textColor="@color/blue1"
            app:ccp_contentColor="@color/blue3"
            app:ccpDialog_backgroundColor="@color/blue3"
            android:layout_marginLeft="@dimen/_5sdp"
            android:fontFamily="@font/quicksand"
            app:ccp_textSize="20sp"
            app:ccp_defaultNameCode="KE"
            app:ccp_autoDetectCountry="true"
            android:id="@+id/ccp_code"/>

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="@dimen/_140sdp"
            android:layout_height="@dimen/_31sdp"
            android:background="@android:color/transparent"
            android:hint="Phone number"
            android:textColorHint="@color/blue3"
            android:layout_marginRight="@dimen/_10sdp"
            android:textSize="20sp"
            android:textColor="@color/blue3"
            android:fontFamily="@font/quicksand"
            android:layout_marginBottom="@dimen/_1sdp"
            android:inputType="phone"
            android:id="@+id/et_phone"/>
    </LinearLayout>

    <CheckBox
        android:layout_width="match_parent"
        android:layout_height="@dimen/_25sdp"
        android:text="I agree to the Terms and Conditions of use"
        android:gravity="center_vertical"
        android:paddingLeft="@dimen/_5sdp"
        android:textSize="14sp"
        android:fontFamily="@font/quicksand"
        android:elevation="8dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/til_phone"
        android:layout_marginTop="@dimen/_15sdp"
        android:layout_marginRight="@dimen/_20sdp"
        android:layout_marginLeft="@dimen/_20sdp"
        android:id="@+id/chk_agree"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="@dimen/_45sdp"
        android:text="Sign Up"
        android:gravity="center_vertical"
        android:paddingLeft="@dimen/_20sdp"
        android:textSize="24sp"
        android:textColor="@color/white"
        android:background="@drawable/button_background"
        android:fontFamily="@font/quicksand"
        android:elevation="8dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chk_agree"
        android:layout_marginTop="@dimen/_15sdp"
        android:layout_marginRight="@dimen/_20sdp"
        android:layout_marginLeft="@dimen/_20sdp"
        android:id="@+id/tv_signup"/>

    <LinearLayout
        android:id="@+id/ll_signin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginRight="@dimen/_30sdp"
        android:layout_marginLeft="@dimen/_30sdp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_signup"
        android:theme="@style/ThemeOverlay.AppCompat.Dark">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Already have an account? "
            android:textSize="16sp"
            android:textColor="@color/blue3"
            android:fontFamily="@font/quicksand"/>

        <TextView
            android:id="@+id/tv_signin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign In"
            android:textColor="@color/teal_700"
            android:textSize="16sp" />
    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>