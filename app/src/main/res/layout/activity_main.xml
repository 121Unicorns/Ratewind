<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:layout_gravity="center"
    android:orientation="vertical"
    style="@style/LayoutBackground"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_400sdp"
        android:background="@drawable/bgflip"
        android:orientation="vertical">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            android:layout_marginTop="@dimen/_10sdp"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            app:elevation="0dp"
            android:layoutDirection="rtl"
            >

            <com.google.android.material.appbar.MaterialToolbar
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                style="@style/Widget.MaterialComponents.Toolbar.Primary"
                android:backgroundTint="@color/blue3"
                app:layout_collapseMode="pin"
                app:navigationIcon="@drawable/ic_menu"
                app:titleTextColor="@color/white"
                app:title="Dashboard"
                app:titleTextAppearance="@style/TabText"
                app:titleMarginStart="@dimen/_163sdp"
                />

        </com.google.android.material.appbar.AppBarLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_40sdp"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginLeft="@dimen/_16sdp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:text="Hello, "
                android:textSize="34sp"
                android:textColor="@color/white"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="World"
                android:textSize="34sp"
                android:textColor="@color/blue1"
                android:id="@+id/tv_profname"/>
        </LinearLayout>
    </LinearLayout>

    <GridView
        android:id="@+id/gv_dashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/_5sdp"
        android:layout_marginTop="@dimen/_105sdp"
        android:layout_marginRight="@dimen/_5sdp"
        android:gravity="center"
        android:horizontalSpacing="@dimen/_2sdp"
        android:numColumns="auto_fit"
        android:stretchMode="columnWidth"
        android:verticalSpacing="@dimen/_1sdp" />

</RelativeLayout>