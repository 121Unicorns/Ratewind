<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="App Settings" >

        <SwitchPreference
            app:key="theme"
            app:icon="@drawable/ic_palette"
            app:title="Use Dark Mode" />

        <SwitchPreference
            app:key="notifications"
            app:title="Receive Notifications"
            app:icon="@drawable/ic_star"
            app:defaultValue="true"/>

    </PreferenceCategory>

    <PreferenceCategory app:title="Profile Settings">

        <EditTextPreference
            app:key="name"
            app:title="Name"
            app:icon="@drawable/ic_prof"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            app:key="email"
            app:title="Email"
            app:icon="@drawable/ic_mail"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

    <PreferenceCategory>

        <Preference
            app:key="save"
            app:title="Save"
            app:icon="@drawable/ic_save"
            app:useSimpleSummaryProvider="true" />

        <Preference
            app:key="signout"
            app:title="Sign Out"
            app:icon="@drawable/ic_logout"
            app:useSimpleSummaryProvider="true" />

        <Preference
            app:key="delete"
            app:title="Delete"
            app:icon="@drawable/ic_delete"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

</PreferenceScreen>